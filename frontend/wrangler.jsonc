{
  "name": "tournament-tracker",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "traces": {
    "enabled": false,
    "head_sampling_rate": 1,
    "persist": true
  }
}
