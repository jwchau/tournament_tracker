        "finished",
        "champion decided",
        "tournament complete (placings)",
        "signed out"
      ]
    },
    "button": { "fill": "--ghost", "radius": "12px", "minHeight": "48px", "padding": "12px 20px", "disabledOpacity": 0.5 },
    "field": { "radius": "0px", "border": "1px --field-border", "minHeight": "48px", "focus": "--accent-text edge plus --focus" }
  },
  "rules": [
    { "id": "amber-means-advancing", "rule": "Amber (--amber, --amber-tint, --amber-text) only marks advancing places and winning results: advancing rows, the advance key, winning bracket scores, the champion label, the champion banner tint, the champion's placings row, the winning side of each finished series game, and the winner's score in pool grid, schedule and bracket card chips. Never decoration, status or emphasis; the live scoreboard and running pool or bracket scores carry none." },
    { "id": "ember-one-primary", "rule": "The ember gradient fills only the one primary action per view (.btn-primary, submit); on the court view that is Finish match or Record game, ember only while enabled. The brand tile is the product mark. Everything else is ghost; +1 is a surface fill." },
    { "id": "ember-glow-band-only", "rule": "--ember-glow appears only on the board-head band; the court strip is plain ink." },
    { "id": "ink-bands-and-boards", "rule": "--ink fills the app bar, board head, court strip, flip cards, score chips, grid result chips and court tags in both themes; text and accents on it use the --band-* tokens." },
    { "id": "standings-are-the-page", "rule": "Organizer tools live in the Manage drawer, disclosures or the bracket match panel, never at equal weight with the board." },
    { "id": "arms-length-targets", "rule": "Interactive elements are at least 48px tall; the exception is the 40px standings refresh. On the court view +1 is 72px (88px on phones) and Finish match 56px. Results-grid cells are 52px. On the bracket page round tabs, Next and court links are at least 48px and the whole top of a match card is its button." },
    { "id": "score-comes-first", "rule": "On a court the two columns and numerals own the first phone view; save status, Finish match and Up next follow in that order, with only the court strip above." },
    { "id": "score-on-the-court", "rule": "Scoring happens on the court scoreboard, not the pool or bracket page. They only link there (Score on Court N / Watch Court N); finished matches can be corrected in place (schedule row or match panel)." },
    { "id": "amber-by-ground", "rule": "Amber on ink uses --amber; on light grounds (panels, tints, surfaces) it uses --amber-text." },
    { "id": "result-vs-appointment", "rule": "A result chip and an appointment must read apart: a result is an ink flip-card chip with numerals, an appointment a quiet --surface-2 cell with small muted slot and court text." },
    { "id": "on-court-is-live", "rule": "A bracket match on a court (both teams, not finished) is marked live: a 2px inset --accent-text ring and a court link. Nothing else on the bracket page wears that ring." },
    { "id": "rounds-named-once", "rule": "Tabs, pages, card-tree heads and Next links say rounds the same way (roundsOf); match names derive from them (Semis · match 2, or the round name alone); status reads in words (matchStatus)." },
    { "id": "tournament-page-read-only-tree", "rule": "The tournament page keeps the read-only SVG tree and champion banner; matches open only on the bracket page." }
  ],
  "notOverhauled": [
    "TeamPage, MainPage, AccountPage, LoginPage, TournamentForm, ScoreEntryForm, CorrectionForm (including Correct on the pool page and in the bracket match panel)",
    "SeriesForm outside board mode (plain game fields, fix-game form, conflict and error lines)"
  ],
  "notCanonized": []
}
