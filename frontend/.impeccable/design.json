      "naming": {
        "source": "bracketModel.js roundsOf / matchLabels / matchStatus",
        "single": [
          "Round N",
          "Quarters",
          "Semis",
          "Final"
        ],
        "double": [
          "Winners Quarters",
          "Winners Semis",
          "Winners final",
          "Losers N",
          "Losers final",
          "Grand final",
          "Reset"
        ],
        "match": "{round} · match {position}, or the round name alone when it has one match",
        "status": [
