{
  "version": 1,
  "name": "Kiln",
  "source": "design.md",
  "section": "As shipped in Tournament Tracker",
  "derivedFrom": [
    "frontend/src/index.css",
    "frontend/src/App.jsx",
    "frontend/src/NavBar.jsx",
    "frontend/src/HealthCheck.jsx",
    "frontend/src/TournamentPage.jsx",
    "frontend/src/PoolsPanel.jsx",
    "frontend/src/PoolStandings.jsx",
    "frontend/src/PlayoffsPanel.jsx",
    "frontend/src/BracketDiagram.jsx",
    "frontend/src/CourtPage.jsx",
    "frontend/src/CourtsPage.jsx",
    "frontend/src/FlipBoard.jsx",
    "frontend/src/LiveScore.jsx",
    "frontend/src/SeriesForm.jsx",
    "frontend/src/SaveStatus.jsx",
    "frontend/src/useRunningScore.js",
    "frontend/src/swapSides.js",
    "frontend/index.html"
  ],
  "scope": [
    "app shell",
    "tournament page /tournaments/:id",
    "courts list /tournaments/:id/courts",
    "court view /tournaments/:id/courts/:court"
  ],
  "themes": {
    "default": "dark",
    "light": "prefers-color-scheme: light"
  },
  "tokens": {
    "color": {
      "--ground": { "dark": "linear-gradient(180deg, #1c1c1c 0%, #161616 100%)", "light": "linear-gradient(180deg, #ffffff 0%, #f6f4f1 100%)" },
      "--ink": { "dark": "linear-gradient(180deg, #151515 0%, #0e0e0e 100%)", "light": "linear-gradient(180deg, #151515 0%, #0e0e0e 100%)", "role": "app bar, board head, court strip, flip cards, score chips" },
      "--panel": { "dark": "linear-gradient(180deg, #262626 0%, #1f1f1f 100%)", "light": "linear-gradient(180deg, #ffffff 0%, #f6f4f1 100%)" },
      "--surface": { "dark": "#1a1a1a", "light": "#ffffff" },
      "--surface-2": { "dark": "#232323", "light": "#f6f4f1" },
      "--surface-3": { "dark": "#2b2b2b", "light": "#e0e0e0" },
      "--text": { "dark": "#eeece9", "light": "#111111" },
      "--muted": { "dark": "#a3a3a3", "light": "#333333" },
      "--subtle": { "dark": "#999999", "light": "#333333" },
      "--accent-text": { "dark": "#ea9557", "light": "#9e5019" },
      "--border": { "dark": "#4d4d4d", "light": "#e0e0e0" },
      "--hairline": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(0, 0, 0, 0.1)" },
      "--field-border": { "dark": "#4d4d4d", "light": "#4d4d4d" },
      "--ghost": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(0, 0, 0, 0.1)" },
      "--ghost-hover": { "dark": "rgba(255, 255, 255, 0.15)", "light": "rgba(0, 0, 0, 0.15)" },
      "--ghost-active": { "dark": "rgba(255, 255, 255, 0.2)", "light": "rgba(0, 0, 0, 0.2)" },
      "--amber": { "dark": "#dfae4e", "light": "#dfae4e" },
      "--amber-tint": { "dark": "rgba(223, 174, 78, 0.1)", "light": "rgba(223, 174, 78, 0.2)" },
      "--amber-text": { "dark": "#dfae4e", "light": "#9e5019", "role": "advancing places, winning scores (bracket and series games), champion label" },
      "--ember": { "dark": "linear-gradient(135deg, #ee9148 0%, #d8742c 100%)", "light": "same", "role": "primary action only" },
      "--ember-hover": { "dark": "linear-gradient(135deg, #f29a52 0%, #e0803a 100%)", "light": "same" },
      "--ember-active": { "dark": "linear-gradient(135deg, #d57a33 0%, #c66a25 100%)", "light": "same" },
      "--on-ember": { "dark": "#231306", "light": "#231306" },
      "--ember-solid": { "dark": "#e68435", "light": "same", "role": "caret and accent-color, including the flip-card typing caret" },
      "--ember-glow": { "dark": "radial-gradient(circle at 80% 20%, rgba(230, 132, 53, 0.14) 0%, rgba(230, 132, 53, 0) 60%)", "light": "same", "role": "board-head band only" },
      "--selection": { "dark": "rgba(230, 132, 53, 0.4)", "light": "same", "role": "::selection background" },
      "--band-text": { "dark": "#eeece9", "light": "#eeece9", "role": "text on ink, including flip numerals and score chips" },
      "--band-muted": { "dark": "#a3a3a3", "light": "#a3a3a3" },
      "--band-accent": { "dark": "#ea9557", "light": "#ea9557", "role": "accent on ink: stage-chip dot, Courts/All courts links, health error dot, pressed Swap sides edge, flip-card typing ring, toast error edge" },
      "--band-ghost": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(255, 255, 255, 0.1)", "role": "ghost fills on ink; toast ring; score-chip top half" },
      "--band-ghost-hover": { "dark": "rgba(255, 255, 255, 0.15)", "light": "rgba(255, 255, 255, 0.15)" },
      "--band-divider": { "dark": "rgba(255, 255, 255, 0.08)", "light": "rgba(255, 255, 255, 0.08)", "role": "app bar bottom rule" },
      "--toast": { "dark": "#232323", "light": "#232323", "role": "toast fill; dark in both themes" },
      "--status-idle": { "dark": "#999999", "light": "#999999", "role": "health dot before the first check" },
      "--error-ring": { "dark": "rgba(234, 149, 87, 0.3)", "light": "rgba(234, 149, 87, 0.3)", "role": "3px halo on the health error dot" },
      "--scrim": { "dark": "rgba(0, 0, 0, 0.5)", "light": "rgba(0, 0, 0, 0.5)", "role": "behind the Manage drawer and the modal" },
      "--flip-seam": { "dark": "rgba(0, 0, 0, 0.7)", "light": "rgba(0, 0, 0, 0.7)", "role": "hinge seam on flip cards (3px) and score chips (1px at .7)" }
    },
    "effect": {
      "--focus": "0 0 0 3px rgba(230, 132, 53, 0.4)",
      "--elevation-3": { "dark": "0 0 0 1px rgba(255, 255, 255, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.05)", "light": "0 0 0 1px rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.05)" },
      "--shadow-float": { "value": "0 8px 24px rgba(0, 0, 0, 0.3)", "role": "toasts only" }
    },
    "font": {
      "--display": "'Unbounded', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "--ui": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "--nav": "'DM Sans', 'Inter', system-ui, sans-serif",
      "--emphasis": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "space": {
      "--gutter": { "base": "16px", "768": "24px", "1024": "40px" },
      "--section-gap": { "base": "32px", "768": "48px", "1024": "56px" },
      "maxWidth": "1200px",
      "courtColumn": "640px"
    },
    "radius": { "field": "0px", "focus": "4px", "tile": "8px", "scoreChip": "8px", "button": "12px", "flipCard": "12px", "row": "12px", "iconButton": "14px", "card": "16px" },
    "motion": {
      "--ease": "cubic-bezier(0.22, 1, 0.36, 1)",
      "state": "200ms ease-in-out",
      "enter": "300ms var(--ease)",
      "match-in": "320ms var(--ease), from opacity 0.4 and translate 0 24px",
      "flip": "flip-fold 90ms ease-in (rotateX 0 to -90deg), then flip-drop 90ms ease-out after 90ms (from rotateX 90deg); 180ms total, perspective 600px",
      "reducedMotion": "all animation and transition off"
    }
  },
  "type": {
    "tournament-name": { "selector": "h2.board-title", "family": "--display", "weight": 700, "size": "32px", "lineHeight": "36px", "from768": { "size": "48px", "lineHeight": "48px" }, "tracking": "-0.02em" },
    "section-head": { "selector": "h3", "family": "--display", "weight": 700, "size": "24px", "lineHeight": "28px", "from768": { "size": "28px", "lineHeight": "32px" }, "tracking": "-0.01em" },
    "card-head": { "selector": ".pool-card-head h4, .results-list strong, .manage-panel-head h3, .modal h2", "family": "--display", "weight": 700, "size": "22px", "lineHeight": "26.4px" },
    "court-strip-name": { "selector": ".court-strip h2", "family": "--display", "weight": 700, "size": "28px", "lineHeight": "32px" },
    "court-tile-name": { "selector": ".court-link-head strong", "family": "--display", "weight": 700, "size": "24px", "lineHeight": "28px" },
    "scoreboard-numeral": {
      "selector": ".flip-half",
      "family": "--display",
      "weight": 700,
      "size": { "oneDigit": "min(84cqi, 168px)", "twoDigits": "min(56cqi, 128px)" },
      "lineHeight": 1.3,
      "tracking": { "oneDigit": "-0.02em", "twoDigits": "-0.04em" },
      "numeric": "tabular-nums",
      "container": ".flip-column and .flip-card (container-type: inline-size)",
      "cardMinHeight": "min(112cqi, 220px)",
      "typing": "min(54cqi, 128px) on the overlaid input"
    },
    "score-chip": { "selector": ".court-link-chip", "family": "--display", "weight": 700, "size": "28px", "lineHeight": "40px", "tracking": "-0.02em", "numeric": "tabular-nums" },
    "up-next-number": { "selector": ".up-next-list > li::before", "family": "--display", "weight": 700, "size": "16px", "color": "--muted", "numeric": "tabular-nums" },
    "brand": { "selector": ".brand", "family": "--display", "weight": 700, "size": "16px" },
    "body": { "selector": ":root", "family": "--ui", "weight": 400, "size": "16.8px", "lineHeight": "25.2px" },
    "ui-heading": { "selector": "h4", "family": "--ui", "weight": 600, "size": "16.8px", "lineHeight": "25.2px" },
    "table": { "family": "--ui", "weight": 400, "size": "16px", "lineHeight": "24px", "numeric": "tabular-nums" },
    "table-head": { "family": "--ui", "weight": 600, "size": "14px", "lineHeight": "20px" },
    "label": { "family": "--ui", "weight": 600, "size": "14.7px", "lineHeight": "21px" },
    "court-label": { "selector": ".court-strip-label, .court-link-label, .court-link-free, .save-status", "family": "--ui", "weight": 500, "size": "14.7px", "lineHeight": "21px" },
    "series-tally": { "selector": ".series-tally", "family": "--ui", "weight": 600, "size": "16px", "lineHeight": "24px", "color": "--muted", "numeric": "tabular-nums" },
    "court-row": { "selector": ".game-line, .up-next-list > li", "family": "--ui", "weight": 500, "size": "16px", "lineHeight": "24px" },
    "note": { "selector": ".section-note, .finish-note", "family": "--ui", "weight": 400, "size": "14px", "lineHeight": "20px" },
    "button-nav": { "selector": "button, .nav-bar, .board-meta, .disclosure > summary, .manage-toggle, .court-strip-link", "family": "--nav", "weight": 500, "size": "16px", "lineHeight": "24px" },
    "primary-action": { "selector": ".btn-primary, button[type='submit']", "family": "--emphasis", "weight": 700, "size": "16px", "lineHeight": "24px" },
    "team-name": { "selector": ".flip-team", "family": "--emphasis", "weight": 700, "size": "18px", "lineHeight": "24px" },
    "score-step": { "selector": ".flip-plus, .flip-minus", "family": "--emphasis", "weight": 700, "size": { "plus": "24px", "minus": "18px" }, "lineHeight": 1, "numeric": "tabular-nums" }
  },
  "components": {
    "app-bar": { "selector": ".app-bar", "fill": "--ink", "rule": "1px --band-divider", "sticky": true, "zIndex": 6, "minHeight": "64px", "health": { "idle": "--status-idle", "error": "--band-accent with 3px --error-ring" }, "phone": "one row below 640px, brand word visually hidden, Home link dropped" },
    "board-head": { "selector": ".board-head", "fill": "--ember-glow over --ink", "text": "--band-text", "link": "--band-accent", "bleed": "full, rounded 0 0 16px 16px from 1200px" },
    "stage-chip": { "selector": ".stage-chip", "radius": "12px", "fill": "--band-ghost", "font": "label", "dot": "8px --band-accent" },
    "pool-card": { "selector": ".pool-grid > .pool-card", "grid": "repeat(auto-fit, minmax(min(100%, 340px), 1fr))", "gap": "16px", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "20px", "usedFor": ["pools", "playoff bracket tiers"] },
    "standings": { "selector": "table[aria-label='Standings']", "advancing": { "row": "background --amber-tint", "rank": "--amber-text, weight 700", "sideStripe": false }, "key": ".advance-note" },
    "results-card": { "selector": ".results-list > li", "treatment": "same as pool-card, gap 6px", "championLabel": "--amber-text, Inter 600 14/20", "championName": "card-head" },
    "manage-drawer": { "selector": "details.manage", "toggle": "--band-ghost", "panel": "fixed right, min(480px, 100%), --surface", "scrim": "--scrim", "enter": "drawer-in 300ms --ease", "sectionGap": "32px" },
    "toast": { "fill": "--toast", "shadow": "0 0 0 1px --band-ghost, --shadow-float", "error": "inset 1px --band-accent, --shadow-float", "enter": "toast-in 300ms --ease" },
    "bracket-diagram": { "selector": ".bracket-svg", "nameSize": "16px", "metaSize": "14px", "metaColor": "--muted", "winningScore": "--amber-text", "matchWidth": 176, "roundGap": 60, "box": "--surface-3 with --hairline stroke", "connector": "--border 1.5px" },
    "court-strip": {
      "selector": ".court-strip",
      "fill": "--ink, no glow",
      "text": "--band-text",
      "label": "--band-muted, Inter 500 14.7/21",
      "link": "--band-accent DM Sans, min-height 48px",
      "pull": "margin-top -24px, padding 12px --gutter",
      "corners": "0 0 16px 16px from 1200px",
      "courtView": ".court-strip-narrow: padding-inline max(var(--gutter), calc((100% - 640px) / 2)); one row below 768px",
      "swapSides": { "selector": ".swap-sides", "fill": "--band-ghost, hover --band-ghost-hover", "pressed": "inset 1px --band-accent", "icon": "20px SVG", "phone": "48px icon-only square below 768px, label visually hidden", "behaviour": "reverses columns on screen only; remembered per court in localStorage court-sides:<tournament>:<court>" }
    },
    "flip-board": {
      "selector": ".flip-board",
      "layout": "two equal columns, gap 12px, max-width 640px centered",
      "column": { "selector": ".flip-column", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "12px (12px 4px 4px below 768px)", "gap": "10px", "teamName": "team-name, min-height 48px" },
      "card": { "selector": ".flip-card", "fill": "--ink", "topHalf": "--band-ghost over --ink", "seam": "3px --flip-seam across the middle", "outline": "1px --hairline ring", "radius": "12px", "numeral": "scoreboard-numeral in --band-text", "halves": "whole numeral clipped to each half, stacked in one grid cell" },
      "flip": "old top half folds down (flip-fold 90ms), new bottom half drops (flip-drop 90ms after 90ms); skipped under reduced motion",
      "typing": "overlaid number input; on focus digits in --band-text on --ink, --ember-solid caret, inset 2px --band-accent",
      "newMatch": "match-in 320ms --ease",
      "readOnly": "spectators: same board, no buttons"
    },
    "score-step": {
      "plus": { "selector": ".flip-plus", "fill": "--surface-3", "hover": "--ghost-hover", "active": "--ghost-active", "minHeight": "72px (88px below 768px)", "width": "column", "icon": "22px SVG" },
      "minus": { "selector": ".flip-minus", "fill": "transparent", "outline": "inset 1px --hairline", "color": "--muted", "minHeight": "48px", "width": "column", "icon": "18px SVG", "disabledAt": 0 },
      "phone": "scorekeeper board fills the first view: min-height calc(100svh - 176px), cards stretch"
    },
    "save-status": { "selector": ".save-status", "role": "status", "font": "court-label", "color": "--muted", "minHeight": "24px", "states": { "idle": "empty", "dirty/saving": "Saving…", "saved": "Saved", "error": "--accent-text + Try again", "conflict": "--accent-text + Refetch latest" }, "debounce": "600ms" },
    "finish-match": { "selector": ".btn-primary.finish-match", "alsoFor": "Record game N on a series board", "width": "100%, max 640px", "minHeight": "56px", "enabled": "--ember", "disabled": "--ghost fill, --muted text, inset 1px --hairline, opacity 1", "note": ".finish-note for a tie", "confirm": "modal before finishing" },
    "series-board": { "selector": ".series-board", "order": ["tally", "game board", "save status", "Record game N", "games so far"], "tally": "series-tally", "gameRow": { "fill": "--surface-2", "radius": "12px", "padding": "8px 8px 8px 16px", "text": "court-row", "winningSide": ".game-won --amber-text 700" } },
    "up-next": { "selector": ".up-next", "width": "max 640px centered", "row": { "fill": "--surface-2", "radius": "12px", "minHeight": "56px", "padding": "8px 16px", "text": "court-row", "number": "up-next-number" }, "placement": "below the fold on phones" },
    "court-list": {
      "selector": ".court-list",
      "grid": "repeat(auto-fill, minmax(min(100%, 300px), 1fr))",
      "gap": "12px",
      "tile": { "selector": ".court-link", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "16px", "gap": "8px", "hover": "inset 1px --accent-text, 200ms", "head": "court-tile-name + court-label" },
      "scoreChip": { "selector": ".court-link-chip", "fill": "--ink with --band-ghost top half", "seam": "1px --flip-seam at 0.7", "ring": "1px --hairline", "radius": "8px", "minWidth": "64px", "padding": "4px 10px", "type": "score-chip in --band-text" },
      "free": { "selector": ".court-link[data-free]", "fill": "transparent", "outline": "inset 1px --hairline, hover --accent-text", "label": "Free, right-aligned, court-label" }
    },
    "empty-court": { "selector": ".setup-note", "text": "Nothing left to play on this court right now." },
    "button": { "fill": "--ghost", "radius": "12px", "minHeight": "48px", "padding": "12px 20px", "disabledOpacity": 0.5 },
    "field": { "radius": "0px", "border": "1px --field-border", "minHeight": "48px", "focus": "--accent-text edge plus --focus" }
  },
  "rules": [
    { "id": "amber-means-advancing", "rule": "Amber (--amber, --amber-tint, --amber-text) only marks advancing places and winning results: advancing rows, the advance key, winning bracket scores, the champion label and the winning side of each finished series game. Never decoration, status or emphasis; the live scoreboard carries none." },
    { "id": "ember-one-primary", "rule": "The ember gradient fills only the one primary action per view (.btn-primary, submit); on the court view that is Finish match or Record game, ember only while enabled. The brand tile is the product mark. Everything else is ghost; +1 is a surface fill." },
    { "id": "ember-glow-band-only", "rule": "--ember-glow appears only on the board-head band; the court strip is plain ink." },
    { "id": "ink-bands-and-boards", "rule": "--ink fills the app bar, board head, court strip, flip cards and score chips in both themes; text and accents on it use the --band-* tokens." },
    { "id": "standings-are-the-page", "rule": "Organizer tools live in the Manage drawer or disclosures, never at equal weight with the board." },
    { "id": "arms-length-targets", "rule": "Interactive elements are at least 48px tall; exceptions are the 32px bracket match actions and the 40px standings refresh. On the court view +1 is 72px (88px on phones) and Finish match 56px." },
    { "id": "score-comes-first", "rule": "On a court the two columns and numerals own the first phone view; save status, Finish match and Up next follow in that order, with only the court strip above." }
  ],
  "notOverhauled": [
    "BracketPage (champion line in BracketDiagram.jsx still renders a trophy emoji; to be replaced, not a system pattern)",
    "PoolPage / PoolSchedule",
    "TeamPage, MainPage, AccountPage, LoginPage, TournamentForm, ScoreEntryForm, CorrectionForm",
    "SeriesForm outside board mode (plain game fields, fix-game form, conflict and error lines)"
  ],
  "notCanonized": [
    { "item": "trophy emoji in BracketDiagram.jsx champion line", "reason": "glyph icon; craft-floor defect awaiting replacement" },
    { "item": "Try again / Refetch latest buttons in .save-status at 40px min-height", "reason": "below the 48px target rule on the view built for arm's length; drift, not a new exception" },
    { "item": "Save game N (fix form, a submit) takes ember alongside Record game N on a series board", "reason": "button[type=submit] selector gives a second ember action while a game is being fixed; drift against ember-one-primary" }
  ]
}
