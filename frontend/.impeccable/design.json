{
  "version": 1,
  "name": "Kiln",
  "source": "design.md",
  "section": "As shipped in Tournament Tracker",
  "derivedFrom": [
    "frontend/src/index.css",
    "frontend/src/App.jsx",
    "frontend/src/NavBar.jsx",
    "frontend/src/HealthCheck.jsx",
    "frontend/src/TournamentPage.jsx",
    "frontend/src/PoolsPanel.jsx",
    "frontend/src/PoolStandings.jsx",
    "frontend/src/PlayoffsPanel.jsx",
    "frontend/src/BracketDiagram.jsx",
    "frontend/src/CourtPage.jsx",
    "frontend/src/CourtsPage.jsx",
    "frontend/src/FlipBoard.jsx",
    "frontend/src/LiveScore.jsx",
    "frontend/src/SeriesForm.jsx",
    "frontend/src/SaveStatus.jsx",
    "frontend/src/useRunningScore.js",
    "frontend/src/swapSides.js",
    "frontend/src/PoolPage.jsx",
    "frontend/src/PoolSchedule.jsx",
    "frontend/src/BracketPage.jsx",
    "frontend/src/BracketBoard.jsx",
    "frontend/src/RoundPages.jsx",
    "frontend/src/CardTree.jsx",
    "frontend/src/MatchCard.jsx",
    "frontend/src/MatchPanel.jsx",
    "frontend/src/bracketModel.js",
    "frontend/index.html"
  ],
  "scope": [
    "app shell",
    "tournament page /tournaments/:id",
    "pool page /pools/:id",
    "bracket page /brackets/:id",
    "courts list /tournaments/:id/courts",
    "court view /tournaments/:id/courts/:court"
  ],
  "themes": {
    "default": "dark",
    "light": "prefers-color-scheme: light"
  },
  "tokens": {
    "color": {
      "--ground": { "dark": "linear-gradient(180deg, #1c1c1c 0%, #161616 100%)", "light": "linear-gradient(180deg, #ffffff 0%, #f6f4f1 100%)" },
      "--ink": { "dark": "linear-gradient(180deg, #151515 0%, #0e0e0e 100%)", "light": "linear-gradient(180deg, #151515 0%, #0e0e0e 100%)", "role": "app bar, board head, court strip, flip cards, score chips, grid result chips, court tags" },
      "--panel": { "dark": "linear-gradient(180deg, #262626 0%, #1f1f1f 100%)", "light": "linear-gradient(180deg, #ffffff 0%, #f6f4f1 100%)", "role": "cards, scoreboard columns, court tiles, results-grid panel, schedule slots; bracket match cards, card-tree panel, placings list, match panel score card" },
      "--surface": { "dark": "#1a1a1a", "light": "#ffffff", "role": "drawer, modal, match panel, root; label of the current round tab" },
      "--surface-2": { "dark": "#232323", "light": "#f6f4f1", "role": "chips, rows, results-grid cells (appointments)" },
      "--surface-3": { "dark": "#2b2b2b", "light": "#e0e0e0", "role": "read-only tree match boxes, loading shimmer, +1" },
      "--text": { "dark": "#eeece9", "light": "#111111", "role": "body and headings; current round tab fill; outline of the match open in the panel" },
      "--muted": { "dark": "#a3a3a3", "light": "#333333", "role": "labels, notes, match card meta and losing row, card-tree round heads, placing numbers" },
      "--subtle": { "dark": "#999999", "light": "#333333" },
      "--accent-text": { "dark": "#ea9557", "light": "#9e5019", "role": "links, focus edge, errors, tile hover ring, Now chip, current-slot rings, selected pairing, live bracket match ring, Next round link" },
      "--border": { "dark": "#4d4d4d", "light": "#e0e0e0", "role": "bracket connectors (read-only tree lines and card-tree elbows), scrollbar" },
      "--hairline": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(0, 0, 0, 0.1)", "role": "rules and strokes, including the hatched grid diagonal, schedule row rules, placings rows and match panel tool sections" },
      "--field-border": { "dark": "#4d4d4d", "light": "#4d4d4d" },
      "--ghost": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(0, 0, 0, 0.1)", "role": "button fill; selected schedule row; hovered bracket match card" },
      "--ghost-hover": { "dark": "rgba(255, 255, 255, 0.15)", "light": "rgba(0, 0, 0, 0.15)" },
      "--ghost-active": { "dark": "rgba(255, 255, 255, 0.2)", "light": "rgba(0, 0, 0, 0.2)" },
      "--amber": { "dark": "#dfae4e", "light": "#dfae4e", "role": "amber on ink: winner's score in grid result chips, schedule score chips and bracket match card chips" },
      "--amber-tint": { "dark": "rgba(223, 174, 78, 0.1)", "light": "rgba(223, 174, 78, 0.2)", "role": "advancing rows; champion banner" },
      "--amber-text": { "dark": "#dfae4e", "light": "#9e5019", "role": "amber on light grounds: advancing places, winning scores (bracket and series games), champion label, champion's row in placings" },
      "--ember": { "dark": "linear-gradient(135deg, #ee9148 0%, #d8742c 100%)", "light": "same", "role": "primary action only" },
      "--ember-hover": { "dark": "linear-gradient(135deg, #f29a52 0%, #e0803a 100%)", "light": "same" },
      "--ember-active": { "dark": "linear-gradient(135deg, #d57a33 0%, #c66a25 100%)", "light": "same" },
      "--on-ember": { "dark": "#231306", "light": "#231306" },
      "--ember-solid": { "dark": "#e68435", "light": "same", "role": "caret and accent-color, including the flip-card typing caret" },
      "--ember-glow": { "dark": "radial-gradient(circle at 80% 20%, rgba(230, 132, 53, 0.14) 0%, rgba(230, 132, 53, 0) 60%)", "light": "same", "role": "board-head band only" },
      "--selection": { "dark": "rgba(230, 132, 53, 0.4)", "light": "same", "role": "::selection background" },
      "--band-text": { "dark": "#eeece9", "light": "#eeece9", "role": "text on ink, including flip numerals, score chips, grid result chips, court tags" },
      "--band-muted": { "dark": "#a3a3a3", "light": "#a3a3a3", "role": "muted text on ink; running (unfinished) scores in schedule chips and bracket match card chips" },
      "--band-accent": { "dark": "#ea9557", "light": "#ea9557", "role": "accent on ink: stage-chip dot, Courts/All courts links, health error dot, pressed Swap sides edge, flip-card typing ring, toast error edge" },
      "--band-ghost": { "dark": "rgba(255, 255, 255, 0.1)", "light": "rgba(255, 255, 255, 0.1)", "role": "ghost fills on ink; toast ring; top half of score chips and grid result chips" },
      "--band-ghost-hover": { "dark": "rgba(255, 255, 255, 0.15)", "light": "rgba(255, 255, 255, 0.15)" },
      "--band-divider": { "dark": "rgba(255, 255, 255, 0.08)", "light": "rgba(255, 255, 255, 0.08)", "role": "app bar bottom rule" },
      "--toast": { "dark": "#232323", "light": "#232323", "role": "toast fill; dark in both themes" },
      "--status-idle": { "dark": "#999999", "light": "#999999", "role": "health dot before the first check" },
      "--error-ring": { "dark": "rgba(234, 149, 87, 0.3)", "light": "rgba(234, 149, 87, 0.3)", "role": "3px halo on the health error dot" },
      "--scrim": { "dark": "rgba(0, 0, 0, 0.5)", "light": "rgba(0, 0, 0, 0.5)", "role": "behind the Manage drawer, the modal and the match panel" },
      "--flip-seam": { "dark": "rgba(0, 0, 0, 0.7)", "light": "rgba(0, 0, 0, 0.7)", "role": "hinge seam on flip cards (3px), score chips and grid result chips (1px at .7)" }
    },
    "effect": {
      "--focus": "0 0 0 3px rgba(230, 132, 53, 0.4)",
      "--elevation-3": { "dark": "0 0 0 1px rgba(255, 255, 255, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.05)", "light": "0 0 0 1px rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.05)" },
      "--shadow-float": { "value": "0 8px 24px rgba(0, 0, 0, 0.3)", "role": "toasts and the match panel sheet" }
    },
    "font": {
      "--display": "'Unbounded', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "--ui": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "--nav": "'DM Sans', 'Inter', system-ui, sans-serif",
      "--emphasis": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "space": {
      "--gutter": { "base": "16px", "768": "24px", "1024": "40px" },
      "--section-gap": { "base": "32px", "768": "48px", "1024": "56px" },
      "maxWidth": "1200px",
      "bracketBreakpoint": "900px (round pages below, card tree and right-hand match panel from)",
      "courtColumn": "640px"
    },
    "radius": { "field": "0px", "focus": "4px", "tile": "8px", "scoreChip": "8px", "courtTag": "8px", "gridCell": "10px", "button": "12px", "chip": "12px", "flipCard": "12px", "row": "12px", "iconButton": "14px", "card": "16px", "matchCardOpen": "12px", "matchPanelScore": "12px", "matchPanelSheet": "16px on the leading corners" },
    "motion": {
      "--ease": "cubic-bezier(0.22, 1, 0.36, 1)",
      "state": "200ms ease-in-out",
      "enter": "300ms var(--ease)",
      "match-in": "320ms var(--ease), from opacity 0.4 and translate 0 24px",
      "target-in": "600ms var(--ease), background from --ghost-active",
      "sheet": "match panel: sheet-up 280ms var(--ease) from translate 0 40px and opacity 0.4 under 900px; sheet-in from translate 40px 0 from 900px",
      "flip": "flip-fold 90ms ease-in (rotateX 0 to -90deg), then flip-drop 90ms ease-out after 90ms (from rotateX 90deg); 180ms total, perspective 600px",
      "reducedMotion": "all animation and transition off"
    }
  },
  "type": {
    "tournament-name": { "selector": "h2.board-title, .pool-page .court-strip h2, .bracket-page .court-strip h2", "family": "--display", "weight": 700, "size": "32px", "lineHeight": "36px", "from768": { "size": "48px", "lineHeight": "48px" }, "tracking": "-0.02em" },
    "section-head": { "selector": "h3", "family": "--display", "weight": 700, "size": "24px", "lineHeight": "28px", "from768": { "size": "28px", "lineHeight": "32px" }, "tracking": "-0.01em" },
    "card-head": { "selector": ".pool-card-head h4, .results-list strong, .champion-name, .manage-panel-head h3, .modal h2, .match-panel-head h3", "family": "--display", "weight": 700, "size": "22px", "lineHeight": "26.4px" },
    "court-strip-name": { "selector": ".court-strip h2", "family": "--display", "weight": 700, "size": "28px", "lineHeight": "32px" },
    "court-tile-name": { "selector": ".court-link-head strong", "family": "--display", "weight": 700, "size": "24px", "lineHeight": "28px" },
    "slot-head": { "selector": ".slot h4", "family": "--display", "weight": 700, "size": "18px", "lineHeight": "24px" },
    "scoreboard-numeral": {
      "selector": ".flip-half",
      "family": "--display",
      "weight": 700,
      "size": { "oneDigit": "min(84cqi, 168px)", "twoDigits": "min(56cqi, 128px)" },
      "lineHeight": 1.3,
      "tracking": { "oneDigit": "-0.02em", "twoDigits": "-0.04em" },
      "numeric": "tabular-nums",
      "container": ".flip-column and .flip-card (container-type: inline-size)",
      "cardMinHeight": "min(112cqi, 220px)",
      "typing": "min(54cqi, 128px) on the overlaid input"
    },
    "score-chip": { "selector": ".court-link-chip", "family": "--display", "weight": 700, "size": "28px", "lineHeight": "40px", "tracking": "-0.02em", "numeric": "tabular-nums" },
    "schedule-score-chip": { "selector": ".score-chip (pool schedule and bracket match cards)", "family": "--display", "weight": 700, "size": "20px", "lineHeight": "34px", "separator": ".score-sep 16px --muted" },
    "grid-score": { "selector": ".grid-entry", "family": "--display", "weight": 700, "size": "17px", "lineHeight": "22px", "phone": "14px", "numeric": "tabular-nums" },
    "grid-letter": { "selector": ".results-grid thead th, .grid-number", "family": "--display", "weight": 700, "size": "14px", "lineHeight": "20px", "color": "--muted" },
    "up-next-number": { "selector": ".up-next-list > li::before", "family": "--display", "weight": 700, "size": "16px", "color": "--muted", "numeric": "tabular-nums" },
    "card-tree-head": { "selector": ".card-tree-head", "family": "--display", "weight": 700, "size": "16px", "lineHeight": "24px", "color": "--muted" },
    "placing-place": { "selector": ".placing-place", "family": "--display", "weight": 700, "size": "18px", "lineHeight": "22px", "color": "--muted", "champion": "--amber-text" },
    "brand": { "selector": ".brand", "family": "--display", "weight": 700, "size": "16px" },
    "body": { "selector": ":root", "family": "--ui", "weight": 400, "size": "16.8px", "lineHeight": "25.2px" },
    "ui-heading": { "selector": "h4", "family": "--ui", "weight": 600, "size": "16.8px", "lineHeight": "25.2px" },
    "table": { "family": "--ui", "weight": 400, "size": "16px", "lineHeight": "24px", "numeric": "tabular-nums" },
    "table-head": { "family": "--ui", "weight": 600, "size": "14px", "lineHeight": "20px" },
    "label": { "family": "--ui", "weight": 600, "size": "14.7px", "lineHeight": "21px" },
    "court-label": { "selector": ".court-strip-label, .court-link-label, .court-link-free, .save-status, .match-panel-tools h4 (600, --muted)", "family": "--ui", "weight": 500, "size": "14.7px", "lineHeight": "21px" },
    "series-tally": { "selector": ".series-tally", "family": "--ui", "weight": 600, "size": "16px", "lineHeight": "24px", "color": "--muted", "numeric": "tabular-nums" },
    "court-row": { "selector": ".game-line, .up-next-list > li", "family": "--ui", "weight": 500, "size": "16px", "lineHeight": "24px" },
    "grid-row-name": { "selector": ".results-grid tbody th", "family": "--ui", "weight": 600, "size": "15px", "lineHeight": "20px", "phone": "14px" },
    "appointment": { "selector": ".grid-when", "family": "--ui", "weight": 500, "size": "13px", "lineHeight": "16px", "color": "--muted" },
    "court-tag": { "selector": ".court-tag", "family": "--ui", "weight": 600, "size": "13px", "lineHeight": "18px", "color": "--band-text" },
    "now-chip": { "selector": ".now-chip", "family": "--ui", "weight": 600, "size": "13px", "lineHeight": "20px", "color": "--accent-text" },
    "slot-teams": { "selector": ".slot-teams", "family": "--ui", "weight": 600, "size": "16px", "lineHeight": "22px" },
    "card-team": { "selector": ".card-team", "family": "--ui", "weight": 600, "size": "17px", "lineHeight": "22px", "lost": "500 in --muted" },
    "card-meta": { "selector": ".round-card-meta", "family": "--ui", "weight": 500, "size": "14px", "lineHeight": "20px", "color": "--muted" },
    "placing-row": { "selector": ".placings li", "family": "--ui", "weight": 500, "size": "16px", "lineHeight": "22px", "champion": "700 in --amber-text" },
    "round-tab": { "selector": ".round-tabs button", "family": "--nav", "weight": 500, "size": "15px", "lineHeight": "20px" },
    "note": { "selector": ".section-note, .finish-note, .slot-idle", "family": "--ui", "weight": 400, "size": "14px", "lineHeight": "20px" },
    "button-nav": { "selector": "button, .nav-bar, .board-meta, .disclosure > summary, .manage-toggle, .court-strip-link, .slot-court-link, .round-next", "family": "--nav", "weight": 500, "size": "16px", "lineHeight": "24px" },
    "primary-action": { "selector": ".btn-primary, button[type='submit']", "family": "--emphasis", "weight": 700, "size": "16px", "lineHeight": "24px" },
    "team-name": { "selector": ".flip-team", "family": "--emphasis", "weight": 700, "size": "18px", "lineHeight": "24px" },
    "score-step": { "selector": ".flip-plus, .flip-minus", "family": "--emphasis", "weight": 700, "size": { "plus": "24px", "minus": "18px" }, "lineHeight": 1, "numeric": "tabular-nums" }
  },
  "components": {
    "app-bar": { "selector": ".app-bar", "fill": "--ink", "rule": "1px --band-divider", "sticky": true, "zIndex": 6, "minHeight": "64px", "health": { "idle": "--status-idle", "error": "--band-accent with 3px --error-ring" }, "phone": "one row below 640px, brand word visually hidden, Home link dropped" },
    "board-head": { "selector": ".board-head", "fill": "--ember-glow over --ink", "text": "--band-text", "link": "--band-accent", "bleed": "full, rounded 0 0 16px 16px from 1200px" },
    "stage-chip": { "selector": ".stage-chip", "radius": "12px", "fill": "--band-ghost", "font": "label", "dot": "8px --band-accent" },
    "pool-card": { "selector": ".pool-grid > .pool-card", "grid": "repeat(auto-fit, minmax(min(100%, 340px), 1fr))", "gap": "16px", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "20px", "usedFor": ["pools", "playoff bracket tiers (read-only tree, Open Bracket link)"] },
    "standings": { "selector": "table[aria-label='Standings']", "advancing": { "row": "background --amber-tint", "rank": "--amber-text, weight 700", "sideStripe": false }, "key": ".advance-note", "usedOn": ["tournament page", "pool page"] },
    "results-card": { "selector": ".results-list > li", "treatment": "same as pool-card, gap 6px", "championLabel": "--amber-text, Inter 600 14/20", "championName": "card-head" },
    "manage-drawer": { "selector": "details.manage", "toggle": "--band-ghost", "panel": "fixed right, min(480px, 100%), --surface", "scrim": "--scrim", "enter": "drawer-in 300ms --ease", "sectionGap": "32px" },
    "toast": { "fill": "--toast", "shadow": "0 0 0 1px --band-ghost, --shadow-float", "error": "inset 1px --band-accent, --shadow-float", "enter": "toast-in 300ms --ease" },
    "champion-banner": { "selector": ".champion", "file": "frontend/src/BracketDiagram.jsx (ChampionBanner)", "text": "{name} win the bracket, one sentence, no label", "type": "card-head in --text", "fill": "--amber-tint", "radius": "16px", "padding": "16px 20px", "marginBottom": "16px", "usedOn": ["tournament page bracket cards", "bracket page"] },
    "bracket-diagram": { "selector": ".bracket-svg", "usedOn": ["tournament page only"], "interactive": false, "nameSize": "16px", "metaSize": "14px", "metaColor": "--muted", "winningScore": "--amber-text, row bold", "matchWidth": 176, "roundGap": 60, "box": "--surface-3 with --hairline stroke, 12px corners", "connector": "straight --border 1.5px" },
    "court-strip": {
      "selector": ".court-strip",
      "usedOn": ["court view", "courts list", "pool page", "bracket page"],
      "fill": "--ink, no glow",
      "text": "--band-text",
      "label": "--band-muted, Inter 500 14.7/21",
      "link": "--band-accent DM Sans, min-height 48px",
      "pull": "margin-top -24px, padding 12px --gutter",
      "corners": "0 0 16px 16px from 1200px",
      "courtView": ".court-strip-narrow: padding-inline max(var(--gutter), calc((100% - 640px) / 2)); one row below 768px",
      "poolPage": "pool name at tournament-name scale (32/36, 48/48 from 768px); label lists the pool's courts; link Back to tournament",
      "bracketPage": "tier (Bracket A) at tournament-name scale; label is the format (Single elimination · best of 3, best-of only above 1); link Back to tournament",
      "swapSides": { "selector": ".swap-sides", "fill": "--band-ghost, hover --band-ghost-hover", "pressed": "inset 1px --band-accent", "icon": "20px SVG", "phone": "48px icon-only square below 768px, label visually hidden", "behaviour": "reverses columns on screen only; remembered per court in localStorage court-sides:<tournament>:<court>" }
    },
    "flip-board": {
      "selector": ".flip-board",
      "layout": "two equal columns, gap 12px, max-width 640px centered",
      "column": { "selector": ".flip-column", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "12px (12px 4px 4px below 768px)", "gap": "10px", "teamName": "team-name, min-height 48px" },
      "card": { "selector": ".flip-card", "fill": "--ink", "topHalf": "--band-ghost over --ink", "seam": "3px --flip-seam across the middle", "outline": "1px --hairline ring", "radius": "12px", "numeral": "scoreboard-numeral in --band-text", "halves": "whole numeral clipped to each half, stacked in one grid cell" },
      "flip": "old top half folds down (flip-fold 90ms), new bottom half drops (flip-drop 90ms after 90ms); skipped under reduced motion",
      "typing": "overlaid number input; on focus digits in --band-text on --ink, --ember-solid caret, inset 2px --band-accent",
      "newMatch": "match-in 320ms --ease",
      "readOnly": "spectators: same board, no buttons"
    },
    "score-step": {
      "plus": { "selector": ".flip-plus", "fill": "--surface-3", "hover": "--ghost-hover", "active": "--ghost-active", "minHeight": "72px (88px below 768px)", "width": "column", "icon": "22px SVG" },
      "minus": { "selector": ".flip-minus", "fill": "transparent", "outline": "inset 1px --hairline", "color": "--muted", "minHeight": "48px", "width": "column", "icon": "18px SVG", "disabledAt": 0 },
      "phone": "scorekeeper board fills the first view: min-height calc(100svh - 176px), cards stretch"
    },
    "save-status": { "selector": ".save-status", "role": "status", "font": "court-label", "color": "--muted", "minHeight": "24px", "states": { "idle": "empty", "dirty/saving": "Saving…", "saved": "Saved", "error": "--accent-text + Try again", "conflict": "--accent-text + Refetch latest" }, "debounce": "600ms" },
    "finish-match": { "selector": ".btn-primary.finish-match", "alsoFor": "Record game N on a series board", "width": "100%, max 640px", "minHeight": "56px", "enabled": "--ember", "disabled": "--ghost fill, --muted text, inset 1px --hairline, opacity 1", "note": ".finish-note for a tie", "confirm": "modal before finishing" },
    "series-board": { "selector": ".series-board", "order": ["tally", "game board", "save status", "Record game N", "games so far"], "tally": "series-tally", "gameRow": { "fill": "--surface-2", "radius": "12px", "padding": "8px 8px 8px 16px", "text": "court-row", "winningSide": ".game-won --amber-text 700" } },
    "up-next": { "selector": ".up-next", "width": "max 640px centered", "row": { "fill": "--surface-2", "radius": "12px", "minHeight": "56px", "padding": "8px 16px", "text": "court-row", "number": "up-next-number" }, "placement": "below the fold on phones" },
    "court-list": {
      "selector": ".court-list",
      "grid": "repeat(auto-fill, minmax(min(100%, 300px), 1fr))",
      "gap": "12px",
      "tile": { "selector": ".court-link", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "16px", "gap": "8px", "hover": "inset 1px --accent-text, 200ms", "head": "court-tile-name + court-label" },
      "scoreChip": { "selector": ".court-link-chip", "fill": "--ink with --band-ghost top half", "seam": "1px --flip-seam at 0.7", "ring": "1px --hairline", "radius": "8px", "minWidth": "64px", "padding": "4px 10px", "type": "score-chip in --band-text" },
      "free": { "selector": ".court-link[data-free]", "fill": "transparent", "outline": "inset 1px --hairline, hover --accent-text", "label": "Free, right-aligned, court-label" }
    },
    "empty-court": { "selector": ".setup-note", "text": "Nothing left to play on this court right now." },
    "pool-page": {
      "selector": ".pool-page",
      "files": ["frontend/src/PoolPage.jsx", "frontend/src/PoolSchedule.jsx"],
      "order": ["court strip", "standings", "results grid", "schedule", "danger zone (signed in)"],
      "sheet": { "selector": ".pool-sheet", "gap": "--section-gap", "mobile": "one column", "from1024": "standings and results grid in two equal columns, column-gap 32px; schedule full width below" },
      "resultsGrid": {
        "selector": ".grid-scroll > table.results-grid",
        "panel": { "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "10px (6px below 640px)", "overflowX": "auto" },
        "cell": { "spacing": "6px (4px below 640px)", "minWidth": "64px (54px below 640px)", "height": "52px", "radius": "10px", "fill": "--surface-2" },
        "headings": "teams lettered A, B, C… (column abbr titled with the team name; grid-number before each row name), never read as ranks",
        "self": { "selector": "td.grid-self", "fill": "repeating-linear-gradient 135deg, --hairline 2px on 7px off" },
        "entry": { "selector": ".grid-entry", "link": "to the match row in the schedule", "hover": "--ghost-hover", "type": "grid-score" },
        "result": { "selector": ".grid-entry.grid-result", "fill": "--band-ghost top half over --ink", "seam": "1px --flip-seam at 0.7", "text": "--band-text", "winner": "--amber" },
        "appointment": { "selector": ".grid-when", "text": "S3 Ct 1 (slot over court below 640px); screen readers get Slot 3 · Court 1", "fill": "--surface-2", "type": "appointment" },
        "now": { "selector": ".grid-entry.grid-now", "ring": "inset 1px --accent-text" },
        "selected": { "selector": ".grid-entry[aria-current]", "outline": "2px solid --accent-text", "offset": "2px (1px below 640px)", "note": "outside the cell, so the Now ring and the selection show together" }
      },
      "schedule": {
        "selector": ".slot-list",
        "gap": "12px",
        "slot": { "selector": ".slot", "fill": "--panel", "radius": "16px", "shadow": "--elevation-3", "padding": "14px 14px 16px", "gap": "10px", "head": "slot-head" },
        "now": { "selector": ".slot[data-now]", "ring": "inset 1px --accent-text over --elevation-3", "chip": { "selector": ".now-chip", "text": "Now", "type": "now-chip", "edge": "inset 1px --accent-text", "radius": "12px", "padding": "2px 10px", "fill": "none" } },
        "row": { "selector": ".slot-match", "layout": "court tag, teams, score; link or Correct on its own line below 768px, at the row's end from 768px", "padding": "10px 4px", "divider": "1px --hairline between rows", "scrollMarginTop": "96px" },
        "courtTag": { "selector": ".court-tag", "fill": "--ink", "text": "--band-text", "type": "court-tag", "radius": "8px", "padding": "5px 9px" },
        "teams": { "selector": ".slot-teams", "type": "slot-teams", "link": "back to the pairing's grid cell", "hover": "--accent-text, underlined" },
        "scoreChip": { "selector": ".score-chip", "fill": "--band-ghost top half over --ink", "seam": "1px --flip-seam at 0.7", "ring": "1px --hairline", "radius": "8px", "minWidth": "44px", "padding": "0 8px", "type": "schedule-score-chip", "winner": "--amber", "running": "--band-muted (.slot-score[data-live])" },
        "courtLink": { "selector": ".slot-court-link", "text": "Score on Court N (signed in) / Watch Court N (signed out)", "color": "--accent-text", "minHeight": "48px", "when": "unfinished match with a court" },
        "correct": "CorrectionForm on finished matches, signed in",
        "idle": { "selector": ".slot-idle", "text": "Observing: … / Resting: …", "type": "note", "color": "--muted" },
        "selected": { "selector": ".slot-match[aria-current], .slot-match:target", "fill": "--ghost", "ring": "inset 2px --accent-text", "radius": "12px", "paddingInline": "10px", "enter": "target-in 600ms --ease" }
      },
      "interaction": "tapping a grid cell or a schedule row selects that pairing in both",
      "states": ["loading", "no schedule (setup note; Generate schedule when signed in)", "in play (current slot)", "finished", "match without a court (Court –, no link)", "signed out"]
    },
    "bracket-page": {
      "selector": ".bracket-page",
      "files": [
        "frontend/src/BracketPage.jsx",
        "frontend/src/BracketBoard.jsx",
        "frontend/src/RoundPages.jsx",
        "frontend/src/CardTree.jsx",
        "frontend/src/MatchCard.jsx",
        "frontend/src/MatchPanel.jsx",
        "frontend/src/bracketModel.js"
      ],
      "gap": "20px",
      "order": [
        "court strip",
        "placings (tournament complete)",
        "connection / overflow notes",
        "champion banner (decided)",
        "round pages (<900px) or card tree (>=900px)"
      ],
      "placings": {
        "selector": ".placings",
        "fill": "--panel",
        "radius": "16px",
        "shadow": "--elevation-3",
        "padding": "6px 16px",
        "row": "padding 10px 0, 1px --hairline between rows",
        "place": "placing-place",
        "teams": "placing-row",
        "champion": "first row in --amber-text, 700",
        "shared": "teams out in the same round share a place, (out in round N)"
      },
      "phone": {
        "below": "900px",
        "view": {
          "selector": ".round-view",
          "gap": "14px"
        },
        "tabs": {
          "selector": "nav.round-tabs button",
          "gap": "8px",
          "type": "round-tab",
          "padding": "12px 16px",
          "minHeight": "48px",
          "fill": "--ghost",
          "current": "aria-pressed: --text fill, --surface label, kept scrolled into view",
          "bleed": "through the gutter, sideways scroll, no scrollbar"
        },
        "pages": {
          "selector": ".round-pages",
          "gap": "12px",
          "snap": "x mandatory, start",
          "page": ".round-page flex 0 0 88% (next round peeks in)",
          "trailingSpacer": "::after flex 0 0 calc(12% - 12px), so the last page snaps flush",
          "sync": "swiping moves the tabs; a tab scrolls to its page",
          "opensOn": "the round being played, else the last played"
        },
        "cards": {
          "selector": ".round-cards",
          "gap": "10px"
        },
        "next": {
          "selector": ".round-next",
          "text": "Next: {round}",
          "color": "--accent-text",
          "fill": "transparent",
          "minHeight": "48px",
          "align": "end",
          "icon": "18px SVG chevron"
        }
      },
      "wide": {
        "from": "900px",
        "panel": {
          "selector": ".bracket-board-tree",
          "fill": "--panel",
          "radius": "16px",
          "shadow": "--elevation-3",
          "padding": "20px",
          "overflowX": "auto"
        },
        "tree": {
          "selector": ".card-tree",
          "component": "CardTree",
          "geometry": "layoutBracket with matchWidth 248, roundGap 56, rowUnit 164; card height 132; heads 36px",
          "cardWidth": "248px",
          "connector": ".bracket-line elbow from the card's right middle, across half the gap, to the next match; --border 1.5px",
          "heads": "card-tree-head per round column; double elimination labels sections (Winners bracket, Losers bracket, Grand final)"
        }
      },
      "matchCard": {
        "selector": ".round-card",
        "component": "BracketCard (MatchTeams, CourtLink)",
        "fill": "--panel",
        "radius": "16px",
        "shadow": "--elevation-3",
        "padding": "4px 4px 10px",
        "open": {
          "selector": ".round-card-open",
          "fill": "transparent, --ghost on hover",
          "radius": "12px",
          "padding": "8px 10px",
          "label": "{match}: A vs B"
        },
        "team": {
          "selector": ".card-team",
          "type": "card-team",
          "minHeight": "40px",
          "empty": "TBD, or BYE once finished"
        },
        "scoreChip": {
          "selector": ".score-chip",
          "type": "schedule-score-chip",
          "winner": ".score-won --amber on ink",
          "loser": "row --muted 500",
          "running": ".score-live --band-muted (single game in play)",
          "series": "games won"
        },
        "meta": {
          "selector": ".round-card-meta",
          "type": "card-meta",
          "padding": "0 10px",
          "holds": "matchStatus, then CourtLink (Score on Court N signed in / Watch Court N signed out) while on a court with both teams"
        },
        "live": {
          "selector": ".round-card[data-live]",
          "when": "on a court, both teams known, not finished",
          "ring": "inset 0 0 0 2px --accent-text, --elevation-3"
        },
        "current": {
          "selector": ".round-card[aria-current]",
          "outline": "2px solid --text",
          "offset": "3px",
          "when": "open in the match panel"
        }
      },
      "matchPanel": {
        "selector": ".match-panel",
        "role": "dialog, named for the match",
        "scrim": ".match-panel-scrim --scrim, z-index 20 (panel 21)",
        "phone": "bottom sheet: full width, max-height 85svh, scrolls, radius 16px 16px 0 0, padding 18px --gutter 28px, sheet-up",
        "from900": "right sheet: min(440px, 100vw), full height, radius 16px 0 0 16px, padding 24px, sheet-in",
        "fill": "--surface",
        "shadow": "--elevation-3, --shadow-float",
        "gap": "14px",
        "holds": [
          "head: match name (card-head) + A vs B note + icon close",
          "score card (.match-panel-score: --panel, 12px, --elevation-3, padding 6px 12px) with MatchTeams",
          "meta line with CourtLink"
        ],
        "signedIn": {
          "sections": ".match-panel-tools, 1px --hairline above, padding-top 14px, gap 10px",
