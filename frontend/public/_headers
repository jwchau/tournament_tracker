# Read by Cloudflare Workers static assets (see wrangler.jsonc). The built files
# in /assets have a content hash in their names, so they never change: a phone
# can keep them for a year instead of re-checking each one on every visit.
# The page itself (index.html) stays revalidated, so a new deploy is picked up.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
